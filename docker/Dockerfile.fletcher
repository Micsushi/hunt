FROM node:22-slim AS checker-node

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

COPY --from=checker-node /usr/local/bin/node /usr/local/bin/node

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
      lmodern \
      texlive-fonts-extra \
      poppler-utils \
      texlive-fonts-recommended \
      texlive-latex-base \
      texlive-latex-extra \
      texlive-latex-recommended \
  && rm -rf /var/lib/apt/lists/*

COPY hunter/requirements.txt /app/hunter/requirements.txt
COPY fletcher/requirements.txt /app/fletcher/requirements.txt
RUN pip install --no-cache-dir -r /app/fletcher/requirements.txt

COPY shared /app/shared
COPY hunter /app/hunter
COPY fletcher /app/fletcher
COPY main.tex /app/main.tex

EXPOSE 8002

CMD ["python", "-m", "uvicorn", "fletcher.service:app", "--host", "0.0.0.0", "--port", "8002"]
