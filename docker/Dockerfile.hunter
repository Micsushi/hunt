FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app

COPY hunter/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt \
  && python -m playwright install --with-deps chromium

COPY shared /app/shared
COPY hunter /app/hunter
COPY wd_test_jobs.csv greenhouse_test_jobs.csv lever_test_jobs.csv ashby_test_jobs.csv /app/

EXPOSE 8001

CMD ["python", "-m", "uvicorn", "hunter.service:app", "--host", "0.0.0.0", "--port", "8001"]
