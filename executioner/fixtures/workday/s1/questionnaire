<!doctype html>
<html lang="en" data-ats="workday" data-page-type="questionnaire" data-fixture-page-id="fixture-questionnaire" data-hunt-page-id="page-questionnaire">
<head>
  <meta charset="utf-8">
  <title>Synthetic questionnaire</title>
  <style>body{font:16px system-ui;margin:2rem auto;max-width:48rem}fieldset,label{display:block;margin:1rem 0}textarea{display:block;min-height:8rem;min-width:28rem}select{display:block;min-width:20rem;padding:.4rem}button{padding:.6rem 1rem}</style>
</head>
<body>
  <main>
    <h1>Application questionnaire</h1>
    <form action="/review" method="get">
      <label>Brief interest statement<textarea data-field-id="s1-field-interest" data-hunt-target-token="target-s1-field-interest" data-question-id="s1-question-configured-narrative" data-question-label="Why are you interested in this role?" name="interest" required></textarea></label>
      <fieldset data-field-id="s1-field-work-authorization" data-hunt-target-token="target-s1-field-work-authorization" data-question-id="s1-question-work-authorization" data-question-label="Are you authorized to work in this location?"><legend>Are you authorized to work in this location?</legend><label><input data-option-id="s1-option-work-authorization-yes" name="workAuthorization" required type="radio" value="yes">Yes</label><label><input data-option-id="s1-option-work-authorization-no" name="workAuthorization" required type="radio" value="no">No</label></fieldset>
      <fieldset><legend>Are you at least 18 years of age?</legend><label><input data-field-id="s1-field-age-requirement" data-hunt-target-token="target-s1-field-age-requirement" data-question-id="s1-question-age-requirement-met" data-question-label="Are you at least 18 years of age?" name="ageRequirement" required type="checkbox">I am at least 18 years of age.</label></fieldset>
      <label>Will you require sponsorship?<select data-field-id="s1-field-sponsorship" data-hunt-target-token="target-s1-field-sponsorship" data-question-id="s1-question-sponsorship-required" data-question-label="Will you require sponsorship?" name="sponsorship" required><option value="" hidden disabled selected></option><option data-option-id="s1-option-sponsorship-yes" value="yes">Yes</option><option data-option-id="s1-option-sponsorship-no" value="no">No</option></select></label>
      <button type="submit" data-action="next" data-hunt-target-token="target-next-questionnaire">Continue</button>
    </form>
  </main>
</body>
</html>
