{
  "manifest_version": 3,
  "name": "Hunt C3",
  "version": "0.1.21",
  "minimum_chrome_version": "125",
  "description": "Fill supported job applications in selected tabs and review them before submission.",
  "permissions": ["debugger", "tabs", "storage", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:47831/*", "https://*.myworkdayjobs.com/*", "https://*.myworkdaysite.com/*"],
  "externally_connectable": { "matches": ["https://agent-hunt-review.mshi.ca/*"] },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Fill with C3" }
}
